{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "server": "node server/index.js",
    "build": "vite build",
    "test": "node --test test/quote.test.js test/seo.test.js test/permissions.test.js test/authRefresh.test.js test/performance.test.js test/productSave.test.js test/editSave.test.js test/rejectedSession.test.js test/vendorLedger.test.js test/routeGuards.test.js test/pagedLoad.test.js test/ledgerCleanup.test.js test/budgetFilter.test.js test/errorTracking.test.js test/errorReports.test.js test/errorMessage.test.js test/cloudinary.test.js test/mediaMigration.test.js test/dbTarget.test.js test/brandFilter.test.js test/brandText.test.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "sitemap": "node scripts/generate_sitemap.mjs",
    "ledger:check": "node scripts/fix_duplicate_ledger.mjs",
    "ledger:fix": "node scripts/fix_duplicate_ledger.mjs --apply",
    "cloudinary:check": "node scripts/cloudinary_check.mjs",
    "cloudinary:backup": "node scripts/cloudinary_backup_existing.mjs",
    "cloudinary:migrate": "node scripts/cloudinary_migrate_to_links.mjs",
    "prebuild": "node scripts/generate_sitemap.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "firebase": "^12.18.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "mongoose": "^8.16.5",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "resend": "^6.24.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
